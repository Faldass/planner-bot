# Bot token (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID of your Discord server (right-click the server icon > Copy Server ID)
GUILD_ID=

# How many minutes before a slot starts the reminder is sent
NOTIFY_MINUTES_BEFORE=10

# Everything else (class roles, notification channels) is configured
# in-app by running /setup on your Discord server after starting the bot —
# no more IDs to copy/paste by hand.
